NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# ------------------------------------------------------------------
# Firebase (Authentication + Cloud Firestore + Realtime Database)
# ------------------------------------------------------------------
# Option A: paste the full service-account JSON as a single line.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}
#
# Option B: provide the three fields individually (recommended for .env).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the quotes; escape newlines as \n on a single line.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Realtime Database URL (for live notifications). Optional but recommended.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Local development against the Firebase Emulator Suite (optional):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ------------------------------------------------------------------
# Cloudinary (image / file storage — replaces S3)
# ------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------
# App URLs / CORS
# ------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------
# Payments (SSLCommerz by default)
# ------------------------------------------------------------------
PAYMENT_GATEWAY=sslcommerz
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_BASE_URL=
BACKEND_PUBLIC_URL=https://api.yourdomain.com

CRON_SECRET=replace-with-cron-secret

# ------------------------------------------------------------------
# Root admin (created in Firebase Auth on first boot)
# ------------------------------------------------------------------
ROOT_ADMIN_EMAIL=root@jphjobs.local
ROOT_ADMIN_PASSWORD=ChangeMeStrong123!
