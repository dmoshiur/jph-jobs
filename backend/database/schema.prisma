generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserStatus { ACTIVE PENDING SUSPENDED DISABLED DELETED }
enum LocationType { COUNTRY DIVISION DISTRICT UPAZILA UNION AREA }
enum CompanyVerificationStatus { PENDING VERIFIED REJECTED SUSPENDED }
enum JobType { FULL_TIME PART_TIME INTERNSHIP CONTRACT TEMPORARY REMOTE ON_SITE }
enum JobStatus { DRAFT PENDING_REVIEW APPROVED REJECTED PUBLISHED EXPIRED CLOSED DELETED }
enum ApplicationStatus { SUBMITTED VIEWED SHORTLISTED INTERVIEW SELECTED REJECTED WITHDRAWN }
enum PackageType { JOB SUBSCRIPTION ADVERTISEMENT }
enum OrderStatus { PENDING PROCESSING COMPLETED CANCELLED EXPIRED }
enum PaymentStatus { PENDING PROCESSING SUCCESS FAILED CANCELLED REFUNDED }
enum AdvertisementStatus { DRAFT PENDING ACTIVE EXPIRED REJECTED }
enum NotificationType { SYSTEM APPLICATION PAYMENT JOB COMPANY ALERT ADMIN }
enum ReportStatus { OPEN IN_REVIEW RESOLVED REJECTED }
enum ReviewStatus { PENDING APPROVED REJECTED }
enum InvoiceStatus { ISSUED PAID VOID REFUNDED }

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  phone           String?     @unique
  passwordHash    String
  status          UserStatus  @default(PENDING)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  roles              UserRole[]
  sessions           Session[]
  candidateProfile   CandidateProfile?
  companyMemberships CompanyMember[]
  companiesOwned     Company[] @relation("CompanyOwner")
  jobsCreated        Job[] @relation("JobCreator")
  applications       Application[]
  savedJobs          SavedJob[]
  jobAlerts          JobAlert[]
  orders             Order[]
  payments           Payment[]
  subscriptions      Subscription[]
  advertisements     Advertisement[]
  notifications      Notification[]
  reports            Report[]
  reviews            Review[]
  auditLogs          AuditLog[] @relation("AuditActor")
  cmsPagesUpdated    CmsPage[] @relation("CmsUpdatedBy")
  settingsUpdated    Setting[] @relation("SettingUpdatedBy")
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshHash  String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       UserRole[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  roles       RolePermission[]
  @@map("permissions")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("email_verification_tokens")
}

model CandidateProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  title           String?
  summary         String?
  expectedSalary  Int?
  yearsExperience Int?
  educationLevel  String?
  districtId      String?
  upazilaId       String?
  cvObjectKey     String?
  portfolioUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  district        Location? @relation("CandidateDistrict", fields: [districtId], references: [id])
  upazila         Location? @relation("CandidateUpazila", fields: [upazilaId], references: [id])
  educations      CandidateEducation[]
  experiences     CandidateExperience[]
  skills          CandidateSkill[]
  @@map("candidate_profiles")
}

model CandidateEducation {
  id          String   @id @default(cuid())
  candidateId String
  institution String
  degree      String
  field       String?
  startYear   Int?
  endYear     Int?
  createdAt   DateTime @default(now())
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  @@map("candidate_educations")
}

model CandidateExperience {
  id          String   @id @default(cuid())
  candidateId String
  company     String
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean  @default(false)
  createdAt   DateTime @default(now())
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  @@map("candidate_experiences")
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  category    String?
  createdAt   DateTime @default(now())
  candidates  CandidateSkill[]
  jobs        JobSkill[]
  @@map("skills")
}

model CandidateSkill {
  candidateId String
  skillId     String
  level       String?
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([candidateId, skillId])
  @@map("candidate_skills")
}

model Location {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  type      LocationType
  parentId  String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  parent    Location?    @relation("LocationTree", fields: [parentId], references: [id])
  children  Location[]   @relation("LocationTree")
  districtJobs Job[]     @relation("JobDistrict")
  upazilaJobs  Job[]     @relation("JobUpazila")
  districtCompanies Company[] @relation("CompanyDistrict")
  upazilaCompanies  Company[] @relation("CompanyUpazila")
  districtCandidates CandidateProfile[] @relation("CandidateDistrict")
  upazilaCandidates CandidateProfile[] @relation("CandidateUpazila")
  businessesDistrict BusinessListing[] @relation("BusinessDistrict")
  businessesUpazila BusinessListing[] @relation("BusinessUpazila")
  @@index([type, isActive])
  @@map("locations")
}

model JobCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  jobs        Job[]
  @@map("job_categories")
}

model Company {
  id                 String   @id @default(cuid())
  ownerId            String
  name               String
  slug               String   @unique
  logoObjectKey      String?
  coverObjectKey     String?
  about              String?
  category           String?
  address            String?
  districtId         String?
  upazilaId          String?
  phone              String?
  email              String?
  website            String?
  socialLinks        Json?
  photos             Json?
  verificationStatus CompanyVerificationStatus @default(PENDING)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  owner              User     @relation("CompanyOwner", fields: [ownerId], references: [id])
  district           Location? @relation("CompanyDistrict", fields: [districtId], references: [id])
  upazila            Location? @relation("CompanyUpazila", fields: [upazilaId], references: [id])
  members            CompanyMember[]
  documents          CompanyDocument[]
  jobs               Job[]
  reviews            Review[]
  @@index([verificationStatus])
  @@index([districtId])
  @@map("companies")
}

model CompanyMember {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  title       String?
  permissions String[] @default([])
  role        String   @default("staff")
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([companyId, userId])
  @@map("company_members")
}

model CompanyDocument {
  id          String   @id @default(cuid())
  companyId   String
  type        String
  objectKey   String
  status      CompanyVerificationStatus @default(PENDING)
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@map("company_documents")
}

model BusinessListing {
  id          String   @id @default(cuid())
  ownerId     String?
  name        String
  slug        String   @unique
  category    String
  description String?
  address     String?
  districtId  String?
  upazilaId   String?
  phone       String?
  email       String?
  website     String?
  socialLinks Json?
  photos      Json?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  district    Location? @relation("BusinessDistrict", fields: [districtId], references: [id])
  upazila     Location? @relation("BusinessUpazila", fields: [upazilaId], references: [id])
  @@index([category])
  @@index([districtId])
  @@map("businesses")
}

model Job {
  id               String    @id @default(cuid())
  creatorId        String
  companyId        String
  categoryId       String?
  packageId        String?
  title            String
  slug             String   @unique
  type             JobType
  vacancy          Int      @default(1)
  salaryMin        Int?
  salaryMax        Int?
  salaryText       String?
  experience       String?
  education        String?
  responsibilities String
  requirements     String
  benefits         String?
  districtId       String?
  upazilaId        String?
  deadline         DateTime
  status           JobStatus @default(DRAFT)
  views            Int       @default(0)
  publishedAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  creator          User     @relation("JobCreator", fields: [creatorId], references: [id])
  company          Company  @relation(fields: [companyId], references: [id])
  category         JobCategory? @relation(fields: [categoryId], references: [id])
  package          Package? @relation(fields: [packageId], references: [id])
  district         Location? @relation("JobDistrict", fields: [districtId], references: [id])
  upazila          Location? @relation("JobUpazila", fields: [upazilaId], references: [id])
  skills           JobSkill[]
  applications     Application[]
  savedBy          SavedJob[]
  alerts           JobAlert[]
  @@index([status, deadline])
  @@index([districtId])
  @@index([categoryId])
  @@map("jobs")
}

model JobSkill {
  jobId   String
  skillId String
  job     Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([jobId, skillId])
  @@map("job_skills")
}

model Application {
  id             String   @id @default(cuid())
  jobId          String
  candidateUserId String
  coverLetter    String?
  cvObjectKey    String?
  status         ApplicationStatus @default(SUBMITTED)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate      User     @relation(fields: [candidateUserId], references: [id], onDelete: Cascade)
  @@unique([jobId, candidateUserId])
  @@index([status])
  @@map("applications")
}

model SavedJob {
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@id([userId, jobId])
  @@map("saved_jobs")
}

model JobAlert {
  id         String   @id @default(cuid())
  userId     String
  jobId      String?
  query      Json
  frequency  String   @default("daily")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  @@map("job_alerts")
}

model Package {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  type        PackageType
  price       Int
  currency    String      @default("BDT")
  durationDays Int?
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  features    PackageFeature[]
  jobs        Job[]
  orders      Order[]
  subscriptions Subscription[]
  @@index([type, isActive])
  @@map("packages")
}

model PackageFeature {
  id        String  @id @default(cuid())
  packageId String
  key       String
  value     String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  @@map("package_features")
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  packageId   String?
  purpose     String
  amount      Int
  currency    String      @default("BDT")
  status      OrderStatus @default(PENDING)
  metadata    Json?
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id])
  package     Package?    @relation(fields: [packageId], references: [id])
  payments    Payment[]
  @@index([status])
  @@map("orders")
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  userId                String
  provider              String
  providerTransactionId String?       @unique
  amount                Int
  currency              String        @default("BDT")
  status                PaymentStatus @default(PENDING)
  gatewayPayload        Json?
  verifiedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  order                 Order         @relation(fields: [orderId], references: [id])
  user                  User          @relation(fields: [userId], references: [id])
  invoice               Invoice?
  @@index([status])
  @@index([orderId])
  @@map("payments")
}

model Invoice {
  id          String        @id @default(cuid())
  paymentId   String        @unique
  number      String        @unique
  status      InvoiceStatus @default(ISSUED)
  amount      Int
  currency    String        @default("BDT")
  objectKey   String?
  issuedAt    DateTime      @default(now())
  payment     Payment       @relation(fields: [paymentId], references: [id])
  @@map("invoices")
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  packageId   String
  status      String   @default("active")
  startsAt    DateTime @default(now())
  endsAt      DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  package     Package  @relation(fields: [packageId], references: [id])
  @@index([status, endsAt])
  @@map("subscriptions")
}

model Advertisement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  placement   String
  targetUrl   String?
  imageObjectKey String?
  status      AdvertisementStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id])
  @@index([status, endsAt])
  @@map("advertisements")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
  @@map("notifications")
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  resource    String
  resourceId  String
  reason      String
  status      ReportStatus @default(OPEN)
  createdAt   DateTime @default(now())
  reporter    User @relation(fields: [reporterId], references: [id])
  @@index([resource, resourceId])
  @@map("reports")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  companyId String?
  rating    Int
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id])
  company   Company? @relation(fields: [companyId], references: [id])
  @@map("reviews")
}

model CmsPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String
  metaTitle   String?
  metaDescription String?
  published   Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User? @relation("CmsUpdatedBy", fields: [updatedById], references: [id])
  @@map("cms_pages")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  isSecret    Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt
  updatedBy   User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id])
  @@map("settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  resource  String
  resourceId String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  admin     User? @relation("AuditActor", fields: [adminId], references: [id], onDelete: SetNull)
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
